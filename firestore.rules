rules_version = '2';
// Règles de sécurité de la base Narabu (à coller dans Firebase > Firestore > Règles).
// Tout le monde peut lire les infos. Pour en envoyer, il faut être connecté (connexion anonyme automatique).
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{id} {
      allow read: if true;
      // une info = un resto, un niveau 1 à 3, l'heure du moment, et rien d'autre
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['v','r','l','z','ts','u','tg','p','g','w','q','c','d'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.r is string && request.resource.data.r.size() < 40
        && request.resource.data.l in [1, 2, 3]
        && request.resource.data.z in ['salle', 'drive']
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts < request.time.toMillis() + 300000
        && request.resource.data.tg is list && request.resource.data.tg.size() <= 6
        && request.resource.data.p in [0, 1, 2, 3, 4, 5]
        && request.resource.data.g in [-1, 0, 1]
        // mesures facultatives : attente chronométrée (minutes), file d'attente, personnes comptées
        && request.resource.data.get('w', 0) is int && request.resource.data.get('w', 0) >= 0 && request.resource.data.get('w', 0) <= 90
        && request.resource.data.get('q', 0) in [0, 1, 2, 3, 4]
        && request.resource.data.get('c', 0) is int && request.resource.data.get('c', 0) >= 0 && request.resource.data.get('c', 0) <= 300
        // temps pour avoir sa commande, donné après coup : 1 moins de 3 min ... 5 plus de 15 min
        && request.resource.data.get('d', 0) in [0, 1, 2, 3, 4, 5];
      // on ne peut modifier que les détails de sa propre info
      allow update: if request.auth != null
        && resource.data.u == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tg', 'p', 'q', 'c', 'd'])
        && request.resource.data.tg is list && request.resource.data.tg.size() <= 6
        && request.resource.data.p in [0, 1, 2, 3, 4, 5]
        && request.resource.data.get('q', 0) in [0, 1, 2, 3, 4]
        && request.resource.data.get('c', 0) is int && request.resource.data.get('c', 0) >= 0 && request.resource.data.get('c', 0) <= 300
        && request.resource.data.get('d', 0) in [0, 1, 2, 3, 4, 5];
      // ménage : seules les infos de plus de 60 jours peuvent être supprimées
      allow delete: if request.auth != null
        && resource.data.ts < request.time.toMillis() - 5184000000;
    }
    // problèmes signalés sur un resto : on peut en envoyer, personne ne peut les lire depuis le site (tu les lis dans la console Firebase)
    match /problemes/{id} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['r', 'k', 'ts', 'u'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.r is string && request.resource.data.r.size() < 40
        && request.resource.data.k in [1, 2, 3, 4, 5]
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts < request.time.toMillis() + 300000;
    }
    // onglet Restaurants : temps pour être servi (k = 'svc') ou table dispo / attente / complet (k = 'tab')
    match /rreports/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['v', 'r', 't', 'k', 's', 'm', 'via', 'sv', 'ts', 'u'])
        && request.resource.data.u == request.auth.uid
        && request.resource.data.r is string && request.resource.data.r.size() < 40
        && request.resource.data.t is string && request.resource.data.t.size() < 20
        && request.resource.data.k in ['svc', 'tab']
        && request.resource.data.s in ['', 'direct', 'attente', 'complet']
        && request.resource.data.m is int && request.resource.data.m >= 0 && request.resource.data.m <= 180
        && request.resource.data.via in ['place', 'appel']
        && request.resource.data.sv in ['', 'midi', 'soir']
        && request.resource.data.ts is number
        && request.resource.data.ts > request.time.toMillis() - 300000
        && request.resource.data.ts < request.time.toMillis() + 300000;
      allow update: if false;
      // ménage : seules les infos de plus de 60 jours peuvent être supprimées
      allow delete: if request.auth != null
        && resource.data.ts < request.time.toMillis() - 5184000000;
    }
    // profil public choisi dans la boutique : 2 numéros de mots (pseudo) et un numéro de cadre, rien d'autre
    match /profils/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['a', 'n', 'c', 'ts'])
        && request.resource.data.a is int && request.resource.data.a >= -1 && request.resource.data.a <= 11
        && request.resource.data.n is int && request.resource.data.n >= -1 && request.resource.data.n <= 11
        && request.resource.data.c is int && request.resource.data.c >= 0 && request.resource.data.c <= 5
        && request.resource.data.ts is number;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // compteur de visites : un total par jour (a = accueil, c = carte, n = nouveaux). Chaque visite ne peut ajouter que 1.
    match /stats/{jour} {
      allow read: if true;
      allow create: if jour.matches('^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.keys().hasOnly(['a', 'c', 'n'])
        && request.resource.data.get('a', 0) in [0, 1]
        && request.resource.data.get('c', 0) in [0, 1]
        && request.resource.data.get('n', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['a', 'c', 'n'])
        && request.resource.data.get('a', 0) - resource.data.get('a', 0) in [0, 1]
        && request.resource.data.get('c', 0) - resource.data.get('c', 0) in [0, 1]
        && request.resource.data.get('n', 0) - resource.data.get('n', 0) in [0, 1];
      allow delete: if false;
    }
  }
}
